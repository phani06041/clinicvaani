# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Live model. gemini-3.8-live is the current default for voice agents;
# gemini-3.8-live-extended-thinking reasons more but answers slower.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Prebuilt voice name (e.g. Kore, Puck, Aoede, Charon)
GEMINI_VOICE=Kore

# PIN for the front-desk console (/staff). CHANGE THIS before sharing the server through a tunnel.
STAFF_PIN=2580

# --- Google Cloud / Vertex AI (use once you have the hackathon credits) ---
# USE_VERTEX=1
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# On Vertex the Live model ids differ; check the Vertex AI Live API page and set GEMINI_LIVE_MODEL.
# Authenticate with: gcloud auth application-default login

# 1 = wipe and re-seed the demo clinic every time the server starts
RESET_DB_ON_START=0
